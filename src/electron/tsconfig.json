{
    "compilerOptions": {
        "strict": true,
        "target": "ESNext",
        "module": "NodeNext",
        "outDir": "../../dist-electron",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "baseUrl": "../..",
        "paths": {
            "@electron/*": [
                "./src/electron/*"
            ],
            "@shared/*": [
                "./src/shared/*"
            ]
        },
        // add global types
        "types": [
            "../../types"
        ]
    },
    "include": [
        "./**/*.ts",
        "./**/*.cts",
        "../../locales/**/*.ts"
    ]
}